          "description": [
            "Fast and accurate in silico Mycobacterium spoligotyping from sequence reads.",
            "SpoTyping: fast and accurate in silico Mycobacterium spoligotyping from sequence reads.",
            "SpoTyping3: fast and accurate in silico Mycobacterium spoligotyping from sequence reads, compatible with Python3."
          ],
          "documentation": [
            {
